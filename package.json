{
  "name": "clawstrum",
  "version": "0.1.0",
  "description": "Autonomous agents on your host, in your Discord, with portable conversations.",
  "type": "module",
  "license": "MIT",
  "author": "Jorin Overwiening and Xu Pan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clawstrum/clawstrum.git"
  },
  "homepage": "https://github.com/clawstrum/clawstrum#readme",
  "bugs": {
    "url": "https://github.com/clawstrum/clawstrum/issues"
  },
  "bin": {
    "clawstrum": "dist/cli.js"
  },
  "files": [
    "scripts/check-build.mjs",
    "scripts/cpu-cap.sh",
    "scripts/cpu-cap-lift.sh",
    "scripts/cpu-cap-bin",
    "scripts/worker-sandbox.sh",
    "scripts/worker-sandbox-noslurm.sh",
    "scripts/transcribe.py",
    "scripts/install-voice.sh",
    "docs/architecture.md",
    "docs/instructions.md",
    "docs/system-prompt.md",
    "docs/provider-instructions.md",
    "docs/hooks-and-gates.md",
    "docs/live-steering.md",
    "docs/operations.md",
    "docs/research.md",
    "docs/research-continuity.md",
    "docs/setup.md",
    "docs/subscriptions.md",
    "docs/testing.md",
    "docs/workflows.md",
    "docs/index.md",
    "dist",
    "templates",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/memory-lifecycle.md",
    "docs/groups.md",
    "docs/orchestration.md",
    "docs/jev.md",
    "docs/performance.md",
    "docs/usage.md",
    "docs/customize.md",
    "docs/configuration.md",
    "docs/cli.md",
    "docs/images"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "node scripts/check-build.mjs",
    "build": "tsc && node scripts/write-build-info.mjs",
    "start": "node dist/cli.js start",
    "dev": "tsx src/cli.ts start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test docs scripts/test-discord.mjs README.md package.json tsconfig.json",
    "format:check": "prettier --check src test docs scripts/test-discord.mjs README.md package.json tsconfig.json",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "pretest": "npm run build",
    "test:discord": "npm run build && node scripts/test-discord.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex-sdk": "0.154.0",
    "cron-parser": "5.10.1",
    "discord.js": "14.27.0",
    "smol-toml": "1.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
